public class TeleSena {

    private Double preco = 10.00;
    private int[] cartela1 = new int[24];
    private int[] cartela2 = new int[24];
    public TeleSena(double preco,int[] cartela1, int[] cartela2){
        this.preco = preco;
        this.cartela1 = cartela1;
        this.cartela2 = cartela2;
    }
    //SETS
    public void setCartela1(int[] cartela1) {
        this.cartela1 = cartela1;
    }
    public void setCartela2(int[] cartela2) {
        this.cartela2 = cartela2;
    }
    public void setPreco(Double preco) {
        this.preco = preco;
    }
    //GETS
    public int[] getCartela1() {
        return cartela1;
    }
    public int[] getCartela2() {
        return cartela2;
    }
    public Double getPreco() {
        return preco;
    }
    //METODOS
}   
